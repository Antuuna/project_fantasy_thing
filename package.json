{
  "name": "fantasy-roster-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:auth": "playwright test tests/auth",
    "test:e2e": "playwright test",
    "test:e2e:production": "E2E_PRODUCTION=1 playwright test",
    "test:db": ".venv/bin/python scripts/testing/run_database.py",
    "test:concurrency": ".venv/bin/python scripts/testing/run_concurrency.py",
    "test:full-data": ".venv/bin/python scripts/testing/run_full_data.py",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
