# Application: Supabase Project URL and publishable key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Canonical application origin used in authentication emails.
APP_URL=http://localhost:3000

# Local importer only: privileged PostgreSQL direct/session-pooler URL.
# Never expose this as NEXT_PUBLIC_* or use it for application requests.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
